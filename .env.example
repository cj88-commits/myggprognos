# Copy this file to .env (forecast pipeline) and/or frontend/.env,
# worker/.dev.vars as needed. None of these are required for local sample
# mode (make sample-data / make dev work with zero configuration).

# --- Forecast pipeline (forecast/src/config.py) ---
# Open-Meteo endpoints. Defaults point at the public, free, keyless API and
# rarely need to be changed.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Frontend (frontend/.env, Vite reads VITE_* at build time) ---
# Base URL of the deployed Cloudflare Worker reporting API. Leave unset to
# run the frontend in offline/demo mode (map + forecast still fully work;
# only report submission is disabled).
VITE_REPORT_API_URL=https://mosquito-risk-reports.<your-subdomain>.workers.dev
# Optional: a richer MapLibre style URL (e.g. from MapTiler's free tier).
# Defaults to MapLibre's keyless demo style if unset.
VITE_MAP_STYLE_URL=

# --- Cloudflare Worker (worker/wrangler.toml + `wrangler secret put`) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
