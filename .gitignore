# Dependencies
node_modules/
.wrangler/

# Build output
frontend/dist/
worker/dist/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Forecast pipeline caches / generated static features (regenerable; see
# scripts/prepare_grid.py, scripts/prepare_static_features.py).
data/cache/
data/static/*.tif
data/static/*.gpkg

# Real GIS source tiles for static feature computation (scripts/
# download_static_gis_data.py) -- several GB of ESA WorldCover + Copernicus
# DEM tiles, free to re-download from public S3 but not sensible to commit.
# cell_features.json (the small, derived-from-these output) IS committed --
# see the note next to it in README "How to refresh static GIS features".
data/static/worldcover/
data/static/dem/
data/static/cell_features.json.placeholder_backup

# OSM land-polygons dataset (scripts/build_osm_land_supplement.py) -- a
# ~925MB global download (osmdata.openstreetmap.de), free to re-download,
# not sensible to commit.
data/static/osm_land/

# NMD2023 base layer raster (scripts/download_nmd_data.py) -- ~10.85GB
# single national GeoTIFF, free CC0 re-download, not sensible to commit.
data/static/nmd/

# Per-tile checkpoint cache for scripts/build_worldcover_boundary.py --
# regenerable from data/static/worldcover/, not sensible to commit.
data/static/worldcover_boundary_cache/

# NOTE: data/generated/ is intentionally NOT ignored. forecast.yml commits
# data/generated/latest on every run (see its "Commit and push updated
# forecast" step) and deploy-pages.yml/netlify.toml both read it straight
# from the repo to bundle with the site; ignoring it here silently broke
# that commit step (git add failed on an explicitly-ignored path) and left
# production permanently serving the small sample dataset from
# frontend/public/data/latest.

# Ad-hoc diagnostic/benchmark script outputs under data/generated/diagnostics/
# -- not consumed by the frontend or forecast pipeline (dev tooling only),
# reproducible from the scripts that made them. Some earlier diagnostics
# files ARE already committed (e.g. report.json/md, benchmark-report.*,
# static-data-audit.*) and stay tracked regardless of these patterns; this
# only stops the forecast.yml commit step's broad `git add data/generated`
# from sweeping in new ad-hoc CSV/JSON dumps like these.
data/generated/diagnostics/*.csv
data/generated/diagnostics/histograms.json
data/generated/diagnostics/scatter_sample.json
data/generated/diagnostics/national-diagnostics*.json
data/generated/diagnostics/historical/

# Claude Code local session settings (not part of the project)
.claude/

# Environment / secrets
.env
.env.local
*.local

# D1 export/backup dumps (e.g. `wrangler d1 export`) -- may contain
# production report data, never sensible to commit regardless of where
# one is generated.
*-backup.sql
d1-backup/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.log

# Coverage
coverage/
